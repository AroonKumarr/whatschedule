generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ScheduledMessage {
  id             String    @id @default(uuid())
  waMessageId    String?   // WhatsApp protocol message ID (key.id) for receipt tracking
  recipient      String    // Phone number or JID e.g. 15551234567@s.whatsapp.net
  recipientName  String?   // Friendly contact name e.g. "HR Manager"
  content        String?   // Message text body or media caption
  type           String    @default("text") // text, image, video, document, audio
  mediaPath      String?   // Absolute or relative path to stored media
  mediaMimeType  String?   // e.g. "video/mp4", "video/quicktime", "image/heic", "image/png"
  mediaFileName  String?   // Original uploaded file name
  scheduledAt    DateTime  // Scheduled dispatch timestamp (UTC)
  status         String    @default("pending") // pending, processing, sent, failed, cancelled
  deliveryStatus String    @default("pending") // pending, sent (single tick), delivered (double tick), read (blue tick)
  error          String?   // Error log if dispatch failed
  sentAt         DateTime? // Timestamp when dispatched
  deliveredAt    DateTime? // Timestamp when delivered to recipient phone
  readAt         DateTime? // Timestamp when recipient opened/read the message
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Contact {
  id              String    @id // JID e.g. 15551234567@s.whatsapp.net
  name            String?   // Saved or WhatsApp notify name
  number          String    // Clean phone number
  avatarUrl       String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
